{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "cargo-fallow",
          "version": "0.0.0",
          "informationUri": "https://github.com/fallow-rs/cargo-fallow",
          "rules": [
            {
              "id": "complexity",
              "shortDescription": {
                "text": "A function is over the cyclomatic or the cognitive complexity limit."
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "level": "warning",
              "message": {
                "text": "The `health-findings` gate failed (not enforced)."
              },
              "descriptor": {
                "id": "health-findings"
              }
            }
          ]
        }
      ],
      "results": [
        {
          "ruleId": "complexity",
          "level": "warning",
          "message": {
            "text": "`entries` has cyclomatic complexity 20 and cognitive complexity 35."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/deps/manifest.rs"
                },
                "region": {
                  "startLine": 70,
                  "startColumn": 8
                }
              }
            }
          ]
        },
        {
          "ruleId": "complexity",
          "level": "warning",
          "message": {
            "text": "`decide` has cyclomatic complexity 28 and cognitive complexity 31."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/visibility/mod.rs"
                },
                "region": {
                  "startLine": 456,
                  "startColumn": 4
                }
              }
            }
          ]
        },
        {
          "ruleId": "complexity",
          "level": "warning",
          "message": {
            "text": "`Surface::grow` has cyclomatic complexity 17 and cognitive complexity 30."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/visibility/mod.rs"
                },
                "region": {
                  "startLine": 320,
                  "startColumn": 8
                }
              }
            }
          ]
        }
      ]
    }
  ]
}

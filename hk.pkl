// Git hooks for this repository. Run `hk install` once per clone.
// The Quality gates section in CONTRIBUTING.md lists the same commands for
// contributors whose hooks did not run.
amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

// Files that can change the result of rustfmt or Clippy.
// fallow also lists `.cargo/config.toml`. This repository has no such file.
local rustInputs = List(
  "**/*.rs",
  "**/Cargo.toml",
  "Cargo.lock",
  "rust-toolchain.toml",
  ".rustfmt.toml",
  ".clippy.toml"
)

local cargoFmt = new Step {
  check = "cargo fmt --all -- --check"
  fix = "cargo fmt --all"
}

// Same command as the Clippy CI job. The repository has one package, so the
// command has no `--workspace` flag.
local cargoClippy = new Step {
  check = "cargo clippy --all-targets --locked -- -D warnings"
}

hooks {
  ["pre-commit"] {
    // Check only. `hk fix` applies the fix commands on request.
    fix = false
    // The git stash stack is shared by every worktree of this repository.
    stash = "none"
    steps {
      ["cargo-fmt"] = (cargoFmt) { glob = rustInputs }
      ["cargo-clippy"] = (cargoClippy) { glob = rustInputs }
      ["typos"] {
        check = "if command -v typos >/dev/null 2>&1; then typos; else sh scripts/hook-tool-hint.sh typos; fi"
      }
      // Block hidden and bidi unicode in staged text files. See
      // scripts/scan-hidden-unicode.py.
      ["hidden-unicode"] {
        check = "if command -v python3 >/dev/null 2>&1; then python3 scripts/scan-hidden-unicode.py --mode committed --staged; fi"
      }
      // A committed merge-conflict marker is an unresolved conflict, or test
      // data that trips conflict scanners. See scripts/check-conflict-markers.sh.
      ["conflict-markers"] {
        check = "sh scripts/check-conflict-markers.sh --staged"
      }
      ["comment-quality"] {
        check = "if command -v node >/dev/null 2>&1; then node scripts/check-comment-quality.mjs --staged; else sh scripts/hook-tool-hint.sh node; fi"
      }
      // A source file over 2000 lines must not grow. The step measures the
      // staged blob. fallow also checks `**/*.ts`. This repository has no
      // TypeScript source.
      ["file-size"] {
        glob = List("**/*.rs", "**/*.mjs")
        check = "if command -v node >/dev/null 2>&1; then node scripts/check-file-size.mjs --staged; else sh scripts/hook-tool-hint.sh node; fi"
      }
      // The `lint:js` script in package.json holds the scope list. The helper
      // reads it from there, so this step holds no copy of the list.
      ["js-lint"] {
        check = "sh scripts/hook-js-lint.sh"
      }
      // Changelog entries go to changelog.d/, never to [Unreleased] in
      // CHANGELOG.md. The step reads the working tree. CI checks the committed
      // result. A release `collect` commit skips it with
      // HK_SKIP_STEPS=changelog-fragments.
      ["changelog-fragments"] {
        glob = List("CHANGELOG.md", "changelog.d/**")
        check = "if command -v node >/dev/null 2>&1; then sh scripts/hook-changelog-fragments.sh; else sh scripts/hook-tool-hint.sh node; fi"
      }
      // fallow also runs miri-cfg here. This repository has no Miri job, so
      // that step does not apply.
    }
  }
  ["commit-msg"] {
    steps {
      // A fresh worktree has no node_modules. CI still runs commitlint.
      ["commitlint"] {
        check = "if [ -x node_modules/.bin/commitlint ]; then node_modules/.bin/commitlint --edit \"{{commit_msg_file}}\"; else echo 'commit-msg: commitlint is not installed, skipping local check (CI still enforces it). Run: npm ci' >&2; fi"
      }
      // The Commit messages workflow fails a pull request commit without a
      // Signed-off-by line for its author. Check it before the push.
      ["dco-signoff"] {
        check = "if command -v node >/dev/null 2>&1; then node .github/scripts/check-dco.mjs --message-file \"{{commit_msg_file}}\"; else sh scripts/hook-tool-hint.sh node; fi"
      }
    }
  }
  // Tests run in CI. To run the full suite locally before a pull request:
  //   cargo test --locked
  // hk passes GIT_DIR and GIT_WORK_TREE to each step. No pre-push step calls
  // git today. Unset both variables in a step that does.
  ["pre-push"] {
    steps {
      ["cargo-fmt"] = cargoFmt
      ["cargo-clippy"] = cargoClippy
      // Same command as the Documentation CI job. A broken intra-doc link
      // passes fmt and Clippy.
      ["cargo-doc"] {
        check = "cargo doc --no-deps --document-private-items"
        env { ["RUSTDOCFLAGS"] = "-D warnings" }
      }
      // Same command as the Unused Dependencies CI job. It catches a
      // dependency whose last use a change removes.
      ["cargo-shear"] {
        check = "if command -v cargo-shear >/dev/null 2>&1; then cargo shear; else sh scripts/hook-tool-hint.sh cargo-shear; fi"
      }
    }
  }
}
